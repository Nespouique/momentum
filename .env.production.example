# Momentum - Production Environment Variables
# Copy this file to .env and fill in the values

# ===================
# Docker Hub Settings
# ===================
# Your DockerHub username (images: nespouique/momentum-web, nespouique/momentum-api)
DOCKERHUB_USERNAME=nespouique
TAG=latest

# ===================
# System
# ===================
TZ=Europe/Paris

# ===================
# Database
# ===================
# Strong password for PostgreSQL (min 16 characters recommended)
DB_PASSWORD=your-secure-database-password-here

# ===================
# Authentication
# ===================
# JWT secret key (min 32 characters, generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# ===================
# URLs
# ===================
# Frontend URL (used for CORS configuration and password reset links)
FRONTEND_URL=https://momentum.yourdomain.com

# Public origin of the MCP server (optional, feature disabled when empty).
# Must reach the API container (port 3001) for /mcp, /oauth/* and /.well-known/oauth-*.
MCP_PUBLIC_URL=https://momentum-mcp.yourdomain.com

# ===================
# Email (Resend)
# ===================
# Required at API startup (email client is initialized on import)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===================
# OpenAI (AI Coaching & Trackable Icon Suggestions)
# ===================
# Required at API startup (OpenAI client is initialized on import)
OPENAI_API_KEY=sk-proj-your-openai-api-key
